# Runtime data: retain only the repository guide and empty-directory markers.
# Explicit parent exceptions keep .gitkeep visible without exposing downloaded
# dataset/model READMEs or nested generated files.
/data/**
!/data/README.md
!/data/raw/
!/data/outputs/
!/data/cache/
!/data/datasets/
!/data/raw/.gitkeep
!/data/outputs/.gitkeep
!/data/cache/.gitkeep
!/data/datasets/.gitkeep

# Model caches, local training checkpoints, downloads and logs
/models/**
!/models/README.md
!/models/checkpoints/
!/models/pretrained/
!/models/checkpoints/.gitkeep
!/models/pretrained/.gitkeep
/samples/
/runs/
/logs/
